# Build output
/pgdu
/pgdu_*.deb
/dist/
/debian-pkg/usr/

# CSV exports written by the TUI
*.csv

# Local tooling / editor
.idea/
.claude/
.devcontainer/
vendor/
# DevContainer base layer (fetched by innoclaude)
.devcontainer/base/
# Generated devcontainer.json (from template + overrides)
.devcontainer/devcontainer.json
# Company overlay (carries deploy tokens) — delete to commit the layer
.devcontainer/company/
# Generated Dockerfile (from template + feature layers)
.devcontainer/Dockerfile.generated
# Developer-local overlay (per-machine overrides, never committed)
.devcontainer/local/
# Feature build state and fetch lock (generated)
.devcontainer/.features-built.json
.devcontainer/.innoclaude.lock
# Update backups
.devcontainer/.update-backup-*
# Claude local settings (liveness hooks are registered here at container start)
.claude/settings.local.json
# MCP artifacts and logs
.downloads/
# Claude notification port files
.claude-notify-ports/
